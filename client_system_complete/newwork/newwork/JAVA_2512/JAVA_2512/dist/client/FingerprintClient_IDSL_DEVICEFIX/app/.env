# Scheduler settings (used by start-tomcat.cmd and run-tomcat-service.cmd)
# Cron format: second minute hour day-of-month month day-of-week
# 5:00 PM every day:
FP_SCHEDULER_CRON=0 * * * * *
FP_SCHEDULER_ZONE=Asia/Kolkata

# Optional: keep scheduler enabled (default true)
# device.delta.sync.scheduler.enabled=true
